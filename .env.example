# --- Core LLM (OpenAI-compatible) ---
TA_API_KEY=your-api-key-here
TA_BASE_URL=https://api.openai.com/v1
TA_LLM_PROVIDER=openai
TA_LLM_QUICK=gpt-4o-mini
TA_LLM_DEEP=gpt-4o
# TA_LLM_TEMPERATURE=0

# --- Security (required in production) ---
# Generate: openssl rand -base64 32
# TA_APP_SECRET_KEY=

# --- Database (optional; default is sqlite in project root) ---
# DATABASE_URL=sqlite:///./data/tradingagents.db

# --- Optional ---
# TA_LANGUAGE=zh
# TA_TRACE=1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- VLM (portfolio screenshot import) ---
# TA_VLM_API_KEY=
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- Email OTP login ---
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=AlphaPilot
# MAIL_SSL=1

# --- FinSkills methodology (optional) ---
# FINSKILLS_ROOT=/path/to/finskills
# STOCK_ANALYSIS_TEAM_ROOT=/path/to/stock-analysis-team

# ── 数据源兜底（可选）────────────────────────────────────────────────────
# 东财对高频访问做 IP 级封禁（实测 RemoteDisconnected，见 akshare issue #6061），
# 而筹码分布、个股资金流等维度都要经过它。配置出口代理可换 IP 恢复这些维度：
#   TA_EM_PROXY=http://127.0.0.1:7890
# 留空则回落到标准 HTTPS_PROXY / HTTP_PROXY；两者都没有时保持直连（行为与从前一致）。
TA_EM_PROXY=

# Tushare Pro 接口 token（个人主页 → 接口TOKEN）。**预留入口**：没配置时相关维度
# 如实声明"未覆盖"，绝不假装取到。门槛参考（2026-09）：
#   120 积分（免费）= 仅非复权日线；2000 积分（200 元/年）= 个股资金流 moneyflow；
#   10000 积分（1000 元/年）= 特色数据（筹码分布 cyq_*）
TUSHARE_TOKEN=
